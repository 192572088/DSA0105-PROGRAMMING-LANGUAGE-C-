#include <iostream>
using namespace std;

class Worker
{
protected:
    int code;
    char name[30];
    float salary;

public:
    void getWorker()
    {
        cout << "Enter Worker Code: ";
        cin >> code;

        cout << "Enter Worker Name: ";
        cin >> name;

        cout << "Enter Salary: ";
        cin >> salary;
    }
};

class Officer
{
protected:
    float DA, HRA;

public:
    void getOfficer()
    {
        cout << "Enter DA: ";
        cin >> DA;

        cout << "Enter HRA: ";
        cin >> HRA;
    }
};

class Manager : public Worker, public Officer
{
    float TA, gross_sal;

public:
    void calculate()
    {
        TA = salary * 0.10;
        gross_sal = salary + DA + HRA + TA;
    }

    void display()
    {
        cout << "\n--- Manager Details ---";
        cout << "\nCode       : " << code;
        cout << "\nName       : " << name;
        cout << "\nSalary     : " << salary;
        cout << "\nDA         : " << DA;
        cout << "\nHRA        : " << HRA;
        cout << "\nTA         : " << TA;
        cout << "\nGross Salary: " << gross_sal << endl;
    }
};

int main()
{
    Manager m;

    m.getWorker();
    m.getOfficer();
    m.calculate();
    m.display();

    return 0;
}
